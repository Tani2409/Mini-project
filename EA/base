//+------------------------------------------------------------------+
//|                                    ThreeCandlePattern_EA_v3.mq5  |
//|              Three-Candle Pattern EA — Version 3 (Optimized)      |
//|                                                                    |
//|  KEY CHANGES from v2:                                              |
//|  - Partial close at 1:1 R:R, let remainder run to full TP         |
//|  - Break-even only after partial close (not too early)            |
//|  - ATR-based trailing stop (wider, adapts to volatility)          |
//|  - RSI filter to avoid overbought/oversold entries                |
//|  - Minimum SL distance in points (critical for Gold/XAUUSD)      |
//|  - Smarter candle quality filter (body vs wick ratio)             |
//+------------------------------------------------------------------+
#property copyright "Three Candle Pattern EA v3"
#property version   "3.00"
#property strict
#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
//=== Input Parameters ================================================
input group "=== Trade Settings ==="
input double   InpLotSize              = 0.01;    // Trade Size (Lots)
input int      InpStopLossTicks        = 1;       // SL Buffer (Ticks beyond entry candle)
input double   InpTakeProfitMultiplier = 2.0;     // TP Multiplier (x SL distance)
input int      InpFixedTakeProfitTicks = 0;       // Fixed TP (Ticks) — 0 = use multiplier
input int      InpMinSLPoints          = 50;      // Minimum SL Distance (Points) — safety net
input group "=== Trading Hours ==="
input int      InpStartHour            = 8;       // Start Hour (Server Time)
input int      InpEndHour              = 13;      // End Hour (Server Time)
input group "=== Entry Indicators ==="
input int      InpEMAPeriod            = 10;      // Entry EMA Period (M5)
input int      InpTrendEMAPeriod       = 50;      // Trend EMA Period (H1) — 0 = off
input int      InpATRPeriod            = 14;      // ATR Period (M5)
input int      InpRSIPeriod            = 14;      // RSI Period (M5) — 0 = off
input group "=== Filters ==="
input bool     InpUseTrendFilter       = true;    // Use H1 Trend Filter
input bool     InpUseRSIFilter         = true;    // Use RSI Filter
input double   InpRSIOverbought        = 70.0;    // RSI Overbought Level (skip Buy above)
input double   InpRSIOversold          = 30.0;    // RSI Oversold Level (skip Sell below)
input double   InpMinCandleBodyPips    = 0.0;     // Min Entry Candle Body (Pips) — 0 = off
input double   InpMaxSpreadPips        = 0.0;     // Max Spread (Pips) — 0 = off
input double   InpMinSL_ATRMult        = 1.0;     // Min SL = ATR x Mult — 0 = off
input group "=== Partial Close ==="
input bool     InpUsePartialClose      = true;    // Enable Partial Close
input double   InpPartialClosePercent  = 50.0;    // % of Position to Close
input double   InpPartialCloseRR       = 1.0;     // Close Partial at R:R (e.g. 1.0 = 1:1)
input group "=== Break-Even ==="
input bool     InpUseBreakEven         = true;    // Enable Break-Even (after partial close)
input int      InpBreakEvenPlusTicks   = 2;       // BE Lock-in (Ticks above entry)
input group "=== Trailing Stop ==="
input bool     InpUseTrailingStop      = true;    // Enable Trailing Stop
input double   InpTrailATRMult         = 1.5;     // Trail Distance = ATR x Mult
input int      InpTrailMinProfitTicks  = 30;      // Start Trail After (Ticks in profit)
input group "=== Risk Management ==="
input int      InpMaxPositions         = 1;       // Max Open Positions — 0 = unlimited
input int      InpMaxDailyLosses       = 5;       // Max Daily Losses — 0 = unlimited
input int      InpCooldownBars         = 3;       // Cooldown Bars After Loss — 0 = off
input group "=== EA Settings ==="
input int      InpMagicNumber          = 100001;  // Magic Number
//=== Global Variables ================================================
CTrade         trade;
int            emaHandle;
int            trendEmaHandle;
int            atrHandle;
int            rsiHandle;
datetime       lastBarTime;
int            dailyLossCount;
int            barsSinceLastLoss;
datetime       currentDay;
// Track which positions have had partial close applied
struct PartialCloseInfo
{
   ulong    ticket;
   bool     partialClosed;
   bool     movedToBE;
   double   originalSL;
   double   originalTP;
   double   entryPrice;
};
PartialCloseInfo partialInfo[];
//+------------------------------------------------------------------+
//| Expert initialization                                              |
//+------------------------------------------------------------------+
int OnInit()
{
   if(InpLotSize <= 0)
   {  Alert("Lot size must be > 0"); return(INIT_PARAMETERS_INCORRECT); }
   if(InpStartHour < 0 || InpStartHour > 23 || InpEndHour < 0 || InpEndHour > 23)
   {  Alert("Hours must be 0-23"); return(INIT_PARAMETERS_INCORRECT); }
   if(InpEMAPeriod < 1)
   {  Alert("EMA period must be >= 1"); return(INIT_PARAMETERS_INCORRECT); }
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(10);
   trade.SetTypeFilling(ORDER_FILLING_FOK);
   //--- M5 EMA
   emaHandle = iMA(_Symbol, PERIOD_M5, InpEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   if(emaHandle == INVALID_HANDLE)
   {  Alert("Failed M5 EMA. Err: ", GetLastError()); return(INIT_FAILED); }
   //--- H1 Trend EMA
   trendEmaHandle = INVALID_HANDLE;
   if(InpUseTrendFilter && InpTrendEMAPeriod > 0)
   {
      trendEmaHandle = iMA(_Symbol, PERIOD_H1, InpTrendEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
      if(trendEmaHandle == INVALID_HANDLE)
      {  Alert("Failed H1 EMA. Err: ", GetLastError()); return(INIT_FAILED); }
   }
   //--- ATR
   atrHandle = INVALID_HANDLE;
   if(InpATRPeriod > 0)
   {
      atrHandle = iATR(_Symbol, PERIOD_M5, InpATRPeriod);
      if(atrHandle == INVALID_HANDLE)
      {  Alert("Failed ATR. Err: ", GetLastError()); return(INIT_FAILED); }
   }
   //--- RSI
   rsiHandle = INVALID_HANDLE;
   if(InpUseRSIFilter && InpRSIPeriod > 0)
   {
      rsiHandle = iRSI(_Symbol, PERIOD_M5, InpRSIPeriod, PRICE_CLOSE);
      if(rsiHandle == INVALID_HANDLE)
      {  Alert("Failed RSI. Err: ", GetLastError()); return(INIT_FAILED); }
   }
   lastBarTime       = 0;
   dailyLossCount    = 0;
   barsSinceLastLoss = 999;
   currentDay        = 0;
   ArrayResize(partialInfo, 0);
   Print("=== ThreeCandlePattern EA v3 Initialized ===");
   Print("Symbol: ", _Symbol, " | Lot: ", InpLotSize, " | TP Mult: ", InpTakeProfitMultiplier);
   Print("Trend: ", InpUseTrendFilter ? "ON" : "OFF",
         " | RSI: ", InpUseRSIFilter ? "ON" : "OFF",
         " | Partial Close: ", InpUsePartialClose ? "ON" : "OFF",
         " | Trail: ", InpUseTrailingStop ? "ON" : "OFF");
   return(INIT_SUCCEEDED);
}
//+------------------------------------------------------------------+
//| Expert deinitialization                                            |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(emaHandle != INVALID_HANDLE)       IndicatorRelease(emaHandle);
   if(trendEmaHandle != INVALID_HANDLE)  IndicatorRelease(trendEmaHandle);
   if(atrHandle != INVALID_HANDLE)       IndicatorRelease(atrHandle);
   if(rsiHandle != INVALID_HANDLE)       IndicatorRelease(rsiHandle);
}
//+------------------------------------------------------------------+
//| Utility functions                                                  |
//+------------------------------------------------------------------+
bool IsWithinTradingHours()
{
   MqlDateTime dt;
   TimeCurrent(dt);
   if(InpStartHour < InpEndHour)
      return (dt.hour >= InpStartHour && dt.hour < InpEndHour);
   else
      return (dt.hour >= InpStartHour || dt.hour < InpEndHour);
}
bool IsNewBar()
{
   datetime currentBarTime = iTime(_Symbol, PERIOD_M5, 0);
   if(currentBarTime == 0) return false;
   if(currentBarTime != lastBarTime)
   {
      lastBarTime = currentBarTime;
      return true;
   }
   return false;
}
void CheckNewDay()
{
   MqlDateTime dt;
   TimeCurrent(dt);
   datetime today = StringToTime(IntegerToString(dt.year) + "." +
                                  IntegerToString(dt.mon) + "." +
                                  IntegerToString(dt.day));
   if(today != currentDay)
   {
      currentDay     = today;
      dailyLossCount = 0;
   }
}
int CountPositions()
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 &&
         PositionGetInteger(POSITION_MAGIC) == InpMagicNumber &&
         PositionGetString(POSITION_SYMBOL) == _Symbol)
         count++;
   }
   return count;
}
double GetTickSize()   { return SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE); }
double GetPipValue()
{
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   if(digits == 3 || digits == 5)
      return SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
   return SymbolInfoDouble(_Symbol, SYMBOL_POINT);
}
bool IsSpreadOK()
{
   if(InpMaxSpreadPips <= 0) return true;
   double spread = SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID);
   return (spread / GetPipValue() <= InpMaxSpreadPips);
}
bool IsCandleBodyOK(double op, double cl)
{
   if(InpMinCandleBodyPips <= 0) return true;
   return (MathAbs(cl - op) / GetPipValue() >= InpMinCandleBodyPips);
}
//+------------------------------------------------------------------+
//| Get H1 trend: +1 bullish, -1 bearish, 0 neutral/disabled         |
//+------------------------------------------------------------------+
int GetTrendDirection()
{
   if(!InpUseTrendFilter || trendEmaHandle == INVALID_HANDLE) return 0;
   double buf[];
   ArraySetAsSeries(buf, true);
   if(CopyBuffer(trendEmaHandle, 0, 0, 2, buf) < 2) return 0;
   double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(price > buf[0]) return +1;
   if(price < buf[0]) return -1;
   return 0;
}
//+------------------------------------------------------------------+
//| Get RSI value at bar index 1                                       |
//+------------------------------------------------------------------+
double GetRSI()
{
   if(rsiHandle == INVALID_HANDLE) return 50.0; // neutral default
   double buf[];
   ArraySetAsSeries(buf, true);
   if(CopyBuffer(rsiHandle, 0, 0, 3, buf) < 3) return 50.0;
   return buf[1];
}
//+------------------------------------------------------------------+
//| Get ATR value at bar index 1                                       |
//+------------------------------------------------------------------+
double GetATR()
{
   if(atrHandle == INVALID_HANDLE) return 0;
   double buf[];
   ArraySetAsSeries(buf, true);
   if(CopyBuffer(atrHandle, 0, 0, 3, buf) < 3) return 0;
   return buf[1];
}
//+------------------------------------------------------------------+
//| Find partial close info for a ticket                              |
//+------------------------------------------------------------------+
int FindPartialInfo(ulong ticket)
{
   for(int i = 0; i < ArraySize(partialInfo); i++)
      if(partialInfo[i].ticket == ticket) return i;
   return -1;
}
//+------------------------------------------------------------------+
//| Add partial close tracking for a new position                     |
//+------------------------------------------------------------------+
void AddPartialInfo(ulong ticket, double sl, double tp, double entry)
{
   int size = ArraySize(partialInfo);
   ArrayResize(partialInfo, size + 1);
   partialInfo[size].ticket        = ticket;
   partialInfo[size].partialClosed = false;
   partialInfo[size].movedToBE     = false;
   partialInfo[size].originalSL    = sl;
   partialInfo[size].originalTP    = tp;
   partialInfo[size].entryPrice    = entry;
}
//+------------------------------------------------------------------+
//| Clean up closed positions from partialInfo                        |
//+------------------------------------------------------------------+
void CleanPartialInfo()
{
   for(int i = ArraySize(partialInfo) - 1; i >= 0; i--)
   {
      bool found = false;
      for(int j = PositionsTotal() - 1; j >= 0; j--)
      {
         ulong ticket = PositionGetTicket(j);
         if(ticket == partialInfo[i].ticket) { found = true; break; }
      }
      if(!found)
      {
         // Remove this entry by shifting
         int last = ArraySize(partialInfo) - 1;
         if(i < last) partialInfo[i] = partialInfo[last];
         ArrayResize(partialInfo, last);
      }
   }
}
//+------------------------------------------------------------------+
//| Manage partial close + break-even + trailing for open positions   |
//+------------------------------------------------------------------+
void ManageOpenPositions()
{
   double tickSize = GetTickSize();
   if(tickSize == 0) return;
   double atr = GetATR();
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagicNumber) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      long   posType   = PositionGetInteger(POSITION_TYPE);
      double openPx    = PositionGetDouble(POSITION_PRICE_OPEN);
      double currentSL = PositionGetDouble(POSITION_SL);
      double currentTP = PositionGetDouble(POSITION_TP);
      double volume    = PositionGetDouble(POSITION_VOLUME);
      int idx = FindPartialInfo(ticket);
      //=== PARTIAL CLOSE ===
      if(InpUsePartialClose && idx >= 0 && !partialInfo[idx].partialClosed && volume > 0)
      {
         double slDist = MathAbs(openPx - partialInfo[idx].originalSL);
         double partialTarget;
         if(posType == POSITION_TYPE_BUY)
         {
            partialTarget = openPx + (slDist * InpPartialCloseRR);
            double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
            if(bid >= partialTarget)
            {
               double closeVol = NormalizeDouble(volume * InpPartialClosePercent / 100.0, 2);
               double minVol = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
               if(closeVol < minVol) closeVol = minVol;
               if(closeVol >= volume) closeVol = NormalizeDouble(volume - minVol, 2);
               if(closeVol >= minVol)
               {
                  if(trade.PositionClosePartial(ticket, closeVol))
                  {
                     partialInfo[idx].partialClosed = true;
                     Print("Partial close BUY: ", closeVol, " lots @ ", bid);
                  }
               }
            }
         }
         else if(posType == POSITION_TYPE_SELL)
         {
            partialTarget = openPx - (slDist * InpPartialCloseRR);
            double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            if(ask <= partialTarget)
            {
               double closeVol = NormalizeDouble(volume * InpPartialClosePercent / 100.0, 2);
               double minVol = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
               if(closeVol < minVol) closeVol = minVol;
               if(closeVol >= volume) closeVol = NormalizeDouble(volume - minVol, 2);
               if(closeVol >= minVol)
               {
                  if(trade.PositionClosePartial(ticket, closeVol))
                  {
                     partialInfo[idx].partialClosed = true;
                     Print("Partial close SELL: ", closeVol, " lots @ ", ask);
                  }
               }
            }
         }
      }
      //=== BREAK-EVEN (only after partial close) ===
      if(InpUseBreakEven && idx >= 0 && partialInfo[idx].partialClosed && !partialInfo[idx].movedToBE)
      {
         if(posType == POSITION_TYPE_BUY)
         {
            double beLevel = openPx + (InpBreakEvenPlusTicks * tickSize);
            beLevel = NormalizeDouble(beLevel, _Digits);
            if(currentSL < beLevel)
            {
               if(trade.PositionModify(ticket, beLevel, currentTP))
               {
                  partialInfo[idx].movedToBE = true;
                  Print("BUY moved to BE+", InpBreakEvenPlusTicks, " ticks");
               }
            }
         }
         else if(posType == POSITION_TYPE_SELL)
         {
            double beLevel = openPx - (InpBreakEvenPlusTicks * tickSize);
            beLevel = NormalizeDouble(beLevel, _Digits);
            if(currentSL > beLevel || currentSL == 0)
            {
               if(trade.PositionModify(ticket, beLevel, currentTP))
               {
                  partialInfo[idx].movedToBE = true;
                  Print("SELL moved to BE+", InpBreakEvenPlusTicks, " ticks");
               }
            }
         }
      }
      //=== TRAILING STOP (ATR-based, only after partial close to let winners run) ===
      if(InpUseTrailingStop && atr > 0 && idx >= 0 && partialInfo[idx].partialClosed)
      {
         double trailDist = atr * InpTrailATRMult;
         if(posType == POSITION_TYPE_BUY)
         {
            double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
            double profitTicks = (bid - openPx) / tickSize;
            if(profitTicks >= InpTrailMinProfitTicks)
            {
               double newSL = NormalizeDouble(bid - trailDist, _Digits);
               if(newSL > currentSL)
                  trade.PositionModify(ticket, newSL, currentTP);
            }
         }
         else if(posType == POSITION_TYPE_SELL)
         {
            double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            double profitTicks = (openPx - ask) / tickSize;
            if(profitTicks >= InpTrailMinProfitTicks)
            {
               double newSL = NormalizeDouble(ask + trailDist, _Digits);
               if(newSL < currentSL || currentSL == 0)
                  trade.PositionModify(ticket, newSL, currentTP);
            }
         }
      }
   }
}
//+------------------------------------------------------------------+
//| Track closed trades for daily loss count                          |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &trans,
                         const MqlTradeRequest &request,
                         const MqlTradeResult &result)
{
   if(trans.type == TRADE_TRANSACTION_DEAL_ADD)
   {
      ulong dealTicket = trans.deal;
      if(dealTicket > 0 && HistoryDealSelect(dealTicket))
      {
         long dealMagic  = HistoryDealGetInteger(dealTicket, DEAL_MAGIC);
         long dealEntry  = HistoryDealGetInteger(dealTicket, DEAL_ENTRY);
         double dealProf = HistoryDealGetDouble(dealTicket, DEAL_PROFIT);
         if(dealMagic == InpMagicNumber && dealEntry == DEAL_ENTRY_OUT)
         {
            if(dealProf < 0)
            {
               dailyLossCount++;
               barsSinceLastLoss = 0;
               Print("Loss #", dailyLossCount, " today | P/L: ", dealProf);
            }
         }
      }
   }
}
//+------------------------------------------------------------------+
//| Expert tick function                                               |
//+------------------------------------------------------------------+
void OnTick()
{
   //--- Always manage open positions every tick
   ManageOpenPositions();
   CleanPartialInfo();
   //--- Only check entries on new M5 bar
   if(!IsNewBar()) return;
   barsSinceLastLoss++;
   CheckNewDay();
   //--- Pre-checks
   if(!IsWithinTradingHours()) return;
   if(InpMaxPositions > 0 && CountPositions() >= InpMaxPositions) return;
   if(InpMaxDailyLosses > 0 && dailyLossCount >= InpMaxDailyLosses) return;
   if(InpCooldownBars > 0 && barsSinceLastLoss < InpCooldownBars) return;
   if(!IsSpreadOK()) return;
   //--- Get candle data: [3]=oldest, [2]=middle, [1]=entry candle
   double open1  = iOpen(_Symbol, PERIOD_M5, 1);
   double close1 = iClose(_Symbol, PERIOD_M5, 1);
   double high1  = iHigh(_Symbol, PERIOD_M5, 1);
   double low1   = iLow(_Symbol, PERIOD_M5, 1);
   double open2  = iOpen(_Symbol, PERIOD_M5, 2);
   double close2 = iClose(_Symbol, PERIOD_M5, 2);
   double high2  = iHigh(_Symbol, PERIOD_M5, 2);
   double low2   = iLow(_Symbol, PERIOD_M5, 2);
   double open3  = iOpen(_Symbol, PERIOD_M5, 3);
   double close3 = iClose(_Symbol, PERIOD_M5, 3);
   double high3  = iHigh(_Symbol, PERIOD_M5, 3);
   double low3   = iLow(_Symbol, PERIOD_M5, 3);
   if(open1 == 0 || open2 == 0 || open3 == 0) return;
   //--- Get indicators
   double emaBuf[];
   ArraySetAsSeries(emaBuf, true);
   if(CopyBuffer(emaHandle, 0, 0, 4, emaBuf) < 4) return;
   double emaAtEntry = emaBuf[1];
   double tickSize = GetTickSize();
   if(tickSize == 0) return;
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double atr      = GetATR();
   int    trendDir = GetTrendDirection();
   double rsi      = GetRSI();
   //--- Candle types
   bool c3Bear = (close3 < open3);
   bool c2Bear = (close2 < open2);
   bool c1Bull = (close1 > open1);
   bool c3Bull = (close3 > open3);
   bool c2Bull = (close2 > open2);
   bool c1Bear = (close1 < open1);
   //=================================================================
   //  BUY SIGNAL
   //=================================================================
   if(c3Bear && c2Bear && c1Bull)
   {
      double highPrev = MathMax(high3, high2);
      if(close1 > highPrev && close1 > emaAtEntry)
      {
         // Trend filter
         if(trendDir < 0) return;
         // RSI filter: skip if already overbought
         if(InpUseRSIFilter && rsi > InpRSIOverbought)
         {
            Print("BUY skip: RSI ", DoubleToString(rsi, 1), " > ", InpRSIOverbought);
            return;
         }
         // Candle body filter
         if(!IsCandleBodyOK(open1, close1)) return;
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         //--- SL calculation
         double slPrice = low1 - (InpStopLossTicks * tickSize);
         // ATR minimum SL
         if(atr > 0 && InpMinSL_ATRMult > 0)
         {
            double minSLDist = atr * InpMinSL_ATRMult;
            if((ask - slPrice) < minSLDist)
               slPrice = ask - minSLDist;
         }
         // Absolute minimum SL in points
         if(InpMinSLPoints > 0)
         {
            double minSLDist = InpMinSLPoints * point;
            if((ask - slPrice) < minSLDist)
               slPrice = ask - minSLDist;
         }
         slPrice = NormalizeDouble(slPrice, _Digits);
         double slDist = ask - slPrice;
         if(slDist <= 0) return;
         //--- TP calculation
         double tpPrice;
         if(InpFixedTakeProfitTicks > 0)
            tpPrice = ask + (InpFixedTakeProfitTicks * tickSize);
         else
            tpPrice = ask + (slDist * InpTakeProfitMultiplier);
         tpPrice = NormalizeDouble(tpPrice, _Digits);
         //--- Execute BUY
         if(trade.Buy(InpLotSize, _Symbol, ask, slPrice, tpPrice, "3CP Buy"))
         {
            ulong posTicket = trade.ResultOrder();
            if(posTicket > 0)
               AddPartialInfo(posTicket, slPrice, tpPrice, ask);
            Print("BUY @ ", ask, " | SL: ", slPrice, " | TP: ", tpPrice,
                  " | SL: ", DoubleToString(slDist / tickSize, 0), " ticks",
                  " | RSI: ", DoubleToString(rsi, 1),
                  " | Trend: ", trendDir > 0 ? "UP" : "FLAT");
         }
         else
            Print("BUY FAILED. Err: ", GetLastError());
      }
   }
   //=================================================================
   //  SELL SIGNAL
   //=================================================================
   if(c3Bull && c2Bull && c1Bear)
   {
      double lowPrev = MathMin(low3, low2);
      if(close1 < lowPrev && close1 < emaAtEntry)
      {
         // Trend filter
         if(trendDir > 0) return;
         // RSI filter: skip if already oversold
         if(InpUseRSIFilter && rsi < InpRSIOversold)
         {
            Print("SELL skip: RSI ", DoubleToString(rsi, 1), " < ", InpRSIOversold);
            return;
         }
         // Candle body filter
         if(!IsCandleBodyOK(open1, close1)) return;
         double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         //--- SL calculation
         double slPrice = high1 + (InpStopLossTicks * tickSize);
         // ATR minimum SL
         if(atr > 0 && InpMinSL_ATRMult > 0)
         {
            double minSLDist = atr * InpMinSL_ATRMult;
            if((slPrice - bid) < minSLDist)
               slPrice = bid + minSLDist;
         }
         // Absolute minimum SL in points
         if(InpMinSLPoints > 0)
         {
            double minSLDist = InpMinSLPoints * point;
            if((slPrice - bid) < minSLDist)
               slPrice = bid + minSLDist;
         }
         slPrice = NormalizeDouble(slPrice, _Digits);
         double slDist = slPrice - bid;
         if(slDist <= 0) return;
         //--- TP calculation
         double tpPrice;
         if(InpFixedTakeProfitTicks > 0)
            tpPrice = bid - (InpFixedTakeProfitTicks * tickSize);
         else
            tpPrice = bid - (slDist * InpTakeProfitMultiplier);
         tpPrice = NormalizeDouble(tpPrice, _Digits);
         //--- Execute SELL
         if(trade.Sell(InpLotSize, _Symbol, bid, slPrice, tpPrice, "3CP Sell"))
         {
            ulong posTicket = trade.ResultOrder();
            if(posTicket > 0)
               AddPartialInfo(posTicket, slPrice, tpPrice, bid);
            Print("SELL @ ", bid, " | SL: ", slPrice, " | TP: ", tpPrice,
                  " | SL: ", DoubleToString(slDist / tickSize, 0), " ticks",
                  " | RSI: ", DoubleToString(rsi, 1),
                  " | Trend: ", trendDir < 0 ? "DOWN" : "FLAT");
         }
         else
            Print("SELL FAILED. Err: ", GetLastError());
      }
   }
}
